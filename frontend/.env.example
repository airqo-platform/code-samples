# Server-only AirQo API token used by /api/airqo.
API_TOKEN=

# Comma-separated cohort IDs explicitly approved for public billboard sharing.
# airqo-public is enabled by default. Never add private cohorts without permission.
AIRQO_PUBLIC_BILLBOARD_COHORTS=

# Public Mapbox token used by map views and reports.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Public endpoint used by the AQI heatmap component.
NEXT_PUBLIC_AQI_API_URL=

# Optional Google Analytics measurement ID.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

